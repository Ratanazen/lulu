{
  "name": "lulu-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/run-app.mjs",
    "run": "node scripts/run-app.mjs",
    "app": "node scripts/run-app.mjs",
    "run:bin": "/home/reny/.local/bin/lulu",
    "run:dev": "npm run build && npx tauri dev",
    "dev:desktop": "npm run build && npx tauri dev",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "npm run build && npx tauri build",
    "build:full": "npm run build && npx tauri build --bundles deb && node scripts/install-desktop.mjs",
    "build:install": "npm run build && npx tauri build --bundles deb && node scripts/install-desktop.mjs",
    "install:app": "node scripts/install-desktop.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "tauri": "tauri",
    "doctor": "node scripts/doctor.mjs",
    "validate:capabilities": "node scripts/validate-capabilities.mjs",
    "update": "node scripts/update-app.mjs",
    "update:app": "node scripts/update-app.mjs",
    "check:update": "git fetch --dry-run 2>&1"
  },

  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-fs": "^2.0.1",
    "@tauri-apps/plugin-os": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
